<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="Кошик"
        android:textSize="22sp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rec_view_cart"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <TextView
        android:id="@+id/tewx_view_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:gravity="end"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_checkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="50dp"
        android:backgroundTint="#F4AD71"
        android:text="Оформити замовлення" />
</LinearLayout>